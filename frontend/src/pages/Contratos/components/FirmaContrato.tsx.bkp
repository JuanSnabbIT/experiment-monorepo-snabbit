import Badge from "@/components/ui/Badge"
import Card, { CardBody, CardHeader, CardHeaderChild } from "@/components/ui/Card"
import { useAppSelector } from "@/store"
import dayjs from "dayjs"


function FirmaContrato() {
    const { detalleContratoEmpresaCliente } = useAppSelector((state) => state.contrato)

    return(
        <Card>
            <CardHeader>
                <CardHeaderChild>
                    <Badge className="text-xl">Firma de Confidencialidad</Badge>
                </CardHeaderChild>
            </CardHeader>
            <CardBody>
                <div className="flex flex-col gap-4">
                    {detalleContratoEmpresaCliente && (
                        <div className="grid grid-cols-3 gap-4">
                            {detalleContratoEmpresaCliente.firmas_confidencialidad.length > 0 ? (
                                <>
                                    <div>
                                        <Badge>Titulo de Acuerdo</Badge>
                                        <div className="ml-4">{detalleContratoEmpresaCliente.firmas_confidencialidad[0].titulo_acuerdo}</div>
                                    </div>
                                    <div>
                                        <Badge>Contenido del Acuerdo</Badge>
                                        <div className="ml-4">{detalleContratoEmpresaCliente.firmas_confidencialidad[0].contenido_acuerdo}</div>
                                    </div>
                                    <div>
                                        <Badge>Usuario</Badge>
                                        <div className="ml-4">{detalleContratoEmpresaCliente.firmas_confidencialidad[0].nombre_usuario}</div>
                                    </div>
                                    <div>
                                        <Badge>Fecha de Envio</Badge>
                                        <div className="ml-4">{dayjs(detalleContratoEmpresaCliente.firmas_confidencialidad[0].fecha_envio).format("DD/MM/YYYY")}</div>
                                    </div>
                                    <div>
                                        <Badge>Firmado</Badge>
                                        <div className="ml-4">{detalleContratoEmpresaCliente.firmas_confidencialidad[0].firmado ? "Si" : "No"}</div>
                                    </div>
                                    <div>
                                        <Badge>Fecha de Firma</Badge>
                                        <div className="ml-4">{dayjs(detalleContratoEmpresaCliente.firmas_confidencialidad[0].fecha_firma).format("DD/MM/YYYY")}</div>
                                    </div>
                                    <div className="col-span-full">
                                        <Badge>Firma</Badge>
                                        <div className="ml-4"><img src={detalleContratoEmpresaCliente.firmas_confidencialidad[0].archivo_firma} alt="" /></div>
                                    </div>
                                </>
                            ) : (
                                <div>Sin Firmas</div>
                            )}
                        </div>
                    )}
                </div>
            </CardBody>
        </Card>
    )
}

export default FirmaContrato