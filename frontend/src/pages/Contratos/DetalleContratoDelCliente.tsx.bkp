import Container from "@/components/layouts/Container/Container"
import PageWrapper from "@/components/layouts/PageWrapper/PageWrapper"
import Subheader, { SubheaderLeft } from "@/components/layouts/Subheader/Subheader"
import Button from "@/components/ui/Button"
import { detalleContratoEmpresaClienteThunk, LIMPIAR_DETALLE_CONTRATO, useAppDispatch, useAppSelector } from "@/store"
import { useNavigate, useParams } from "react-router-dom"
import TablaVisitasContrato from "../Clientes/components/TablaVisitasContrato"
import { useEffect } from "react"
import TablaUsuarioVinculadoContrato from "../Clientes/components/TablaUsuarioVinculadoContrato"
import TablaLicenciasContrato from "../Clientes/components/TablaLicenciasContrato"
import Badge from "@/components/ui/Badge"
import dayjs from "dayjs"
import Card, { CardBody, CardHeader, CardHeaderChild } from "@/components/ui/Card"
import TablaCondicionesEspecialesContrato from "../Clientes/components/TablaCondicionesEspecialesContrato"
import FirmaContrato from "../Clientes/components/FirmaContrato"


function DetalleContratoDelCliente() {
    const dispatch = useAppDispatch()
    const navigate = useNavigate()
    const { id } = useParams()
    const { detalleContratoEmpresaCliente } = useAppSelector((state) => state.contrato)

    useEffect(() => {
        if (id) {
            dispatch(detalleContratoEmpresaClienteThunk({id_contrato: id}))
        }

        return () => {
            dispatch(LIMPIAR_DETALLE_CONTRATO())
        }
    }, [id])

    return (
        <PageWrapper isProtectedRoute={true} name="Detalle Contrato del Cliente" title="Detalle Contrato del Cliente">
            <Subheader>
                <SubheaderLeft>
                    <Button icon="HeroArrowSmallLeft" onClick={() => {navigate(-1)}}></Button>
                </SubheaderLeft>
            </Subheader>
            <Container className="w-full h-full">
                <div className="flex flex-col gap-4">
                    <Card>
                        <CardHeader>
                            <CardHeaderChild>
                                <Badge className="text-xl">{detalleContratoEmpresaCliente?.nombre}</Badge>
                            </CardHeaderChild>
                        </CardHeader>
                        <CardBody className="grid grid-cols-3 gap-4">
                            <div>
                                <Badge>Fecha de Inicio</Badge>
                                <div className="ml-4">{dayjs(detalleContratoEmpresaCliente?.fecha_inicio).format("DD/MM/YYYY")}</div>
                            </div>
                            <div>
                                <Badge>Fecha de Fin</Badge>
                                <div className="ml-4">{detalleContratoEmpresaCliente?.fecha_fin ? dayjs(detalleContratoEmpresaCliente.fecha_fin).format("DD/MM/YYYY") : "Sin Fecha"}</div>
                            </div>
                            <div>
                                <Badge>Estado</Badge>
                                <div className="ml-4">{detalleContratoEmpresaCliente?.estado_label}</div>
                            </div>
                            <div className="col-span-full">
                                <Badge>Observaciones</Badge>
                                <div className="ml-4">{detalleContratoEmpresaCliente?.observaciones || "Sin Observaciones"}</div>
                            </div>
                        </CardBody>
                    </Card>
                    <TablaUsuarioVinculadoContrato />
                    {/* <TablasServiciosPlanesContrato /> */}
                    <TablaVisitasContrato />
                    <TablaLicenciasContrato />
                    <TablaCondicionesEspecialesContrato />
                    <FirmaContrato />
                </div>
            </Container>
        </PageWrapper>
    )
}

export default DetalleContratoDelCliente