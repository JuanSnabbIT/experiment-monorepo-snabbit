{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Runserver",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["manage.py", "runserver", "0.0.0.0:8000"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "dev",
        "panel": "shared",
        "reveal": "always"
      },
      "group": {
        "kind": "build"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Performing system checks",
          "endsPattern": "^Quit the server|Starting development server"
        }
      }
    },
    {
      "label": "Frontend: Dev Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--port", "5173"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "group": "dev",
        "panel": "shared",
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^  VITE",
          "endsPattern": "Local:.*http"
        }
      }
    },
    {
      "label": "Backend: Celery Worker",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": [
        "-m",
        "celery",
        "-A",
        "sw_erp",
        "worker",
        "--loglevel=info",
        "--pool=solo",
        "--concurrency=1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "dev",
        "panel": "shared",
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^celery@",
          "endsPattern": "ready\\."
        }
      }
    },
    {
      "label": "Backend: Celery Beat",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["-m", "celery", "-A", "sw_erp", "beat", "--loglevel=info"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "group": "dev",
        "panel": "shared",
        "reveal": "always"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^celery beat",
          "endsPattern": "beat: Starting"
        }
      }
    },
    {
      "label": "Backend: Make Migrations",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["manage.py", "makemigrations"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    },
    {
      "label": "Backend: Migrate",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["manage.py", "migrate"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      }
    },
    {
      "label": "Backend: Migrations (Make + Migrate)",
      "dependsOn": ["Backend: Make Migrations", "Backend: Migrate"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Backend: Setup Superuser",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["..\\dev\\scripts\\setup\\setup_superuser.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Seed Base",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["..\\dev\\scripts\\setup\\seed_base.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Reset DB",
      "type": "shell",
      "command": "C:\\Users\\LuisRojasMolina\\anaconda3\\envs\\ENV\\python.exe",
      "args": ["..\\dev\\scripts\\setup\\reset_db.py"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Backend (Runserver + Celery)",
      "dependsOn": [
        "Backend: Runserver",
        "Backend: Celery Worker",
        "Backend: Celery Beat"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Dev: Start All (Backend + Frontend)",
      "dependsOn": ["Dev: Start Backend (Runserver + Celery)", "Frontend: Dev Server"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Docker: Build+Push Backend (erpsnabbit-backend)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build-and-push-backend.ps1",
        "-Registry",
        "${input:dockerRegistry}",
        "-ImageName",
        "erpsnabbit-backend"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Build+Push Frontend (erpsnabbit-frontend)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build-and-push-frontend.ps1",
        "-Registry",
        "${input:dockerRegistry}",
        "-ImageName",
        "erpsnabbit-frontend",
        "-ViteApiUrl",
        "${input:viteApiUrl}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Build+Push Backend (Optimized)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build-and-push-backend.ps1",
        "-Registry",
        "${input:dockerRegistry}",
        "-ImageName",
        "erpsnabbit-backend",
        "-UseOptimized"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Build+Push Frontend (Optimized)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build-and-push-frontend.ps1",
        "-Registry",
        "${input:dockerRegistry}",
        "-ImageName",
        "erpsnabbit-frontend",
        "-ViteApiUrl",
        "${input:viteApiUrl}",
        "-UseOptimized"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "echo": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "dockerRegistry",
      "type": "promptString",
      "description": "Registry Docker (ej: contenedores.snabbit.cl)",
      "default": "contenedores.snabbit.cl"
    },
    {
      "id": "viteApiUrl",
      "type": "promptString",
      "description": "VITE_API_URL (opcional; vacío para no hornear)",
      "default": ""
    }
  ]
}
