{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/backend/ENV/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DJANGO_SETTINGS_MODULE": "sw_erp.settings"
      }
    },
    {
      "name": "Django: Shell",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["shell"],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/backend/ENV/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DJANGO_SETTINGS_MODULE": "sw_erp.settings"
      }
    },
    {
      "name": "Django: Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["test"],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/backend/ENV/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DJANGO_SETTINGS_MODULE": "sw_erp.settings"
      }
    },
    {
      "name": "Celery: Worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "sw_erp", "worker", "--loglevel=info"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/backend/ENV/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DJANGO_SETTINGS_MODULE": "sw_erp.settings"
      }
    },
    {
      "name": "Celery: Beat",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "sw_erp", "beat", "--loglevel=info"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/backend/ENV/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "DJANGO_SETTINGS_MODULE": "sw_erp.settings"
      }
    },
    {
      "name": "React: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "browserLaunchLocation": "workspace"
    }
  ]
}
