# Copia este archivo a .env y completa los valores.

# URL base del ERP (sin slash final).
ERP_BASE_URL=https://gestion.snabbit.cl

# Token DRF del usuario de servicio (generado con:
#   python manage.py crear_agente_cotizador --email agente@miempresa.cl --sucursal <id>)
ERP_TOKEN=pega_aqui_tu_token

# Timeout de las llamadas HTTP en segundos (opcional).
ERP_TIMEOUT=30
